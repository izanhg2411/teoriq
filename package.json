{
  "name": "teoriq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TEORIQ: registra automáticamente tus errores en los tests del permiso B, analiza tus puntos débiles y planifica el repaso.",
  "scripts": {
    "build": "node build.mjs",
    "build:dev": "node build.mjs --dev",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "icons": "node scripts/icons.mjs",
    "serve:test": "node scripts/serve-test-page.mjs",
    "e2e": "node tests/e2e.mjs",
    "zip": "node scripts/zip.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run e2e"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.300",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "playwright": "^1.56.0",
    "sharp": "^0.34.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
